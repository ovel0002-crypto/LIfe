# Copy to infra/.env on the server (or repo-root .env for local dev).

# ---- Required on a server ----
LIFE_DOMAIN=life.example.com
POSTGRES_PASSWORD=change-me
# Long random string; paste the same value into the app's Settings → Server.
LIFE_API_TOKEN=change-me-too

# ---- AI (planning works without it; chat/triage need it) ----
ANTHROPIC_API_KEY=
# Hard monthly cap in USD. AI features pause when reached; planning keeps working.
LIFE_MONTHLY_BUDGET_USD=10
# "anthropic" (API key) or "claude-cli" (runs `claude -p` signed into your Claude plan; text-only jobs)
LIFE_LLM_PROVIDER=anthropic
# LIFE_MODEL_FAST=claude-haiku-5-5
# LIFE_MODEL_SMART=claude-sonnet-5-5

# ---- Google (Calendar + Gmail, personal and Monash accounts) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://life.example.com/api/connect/google/callback

# ---- Team tools ----
NOTION_TOKEN=
DISCORD_BOT_TOKEN=

# ---- Notifications ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Memory (optional; built-in memory is used if unset) ----
EUNOMIA_URL=
EUNOMIA_TOKEN=
